# API root used by the browser.
#   - leave as /api to go through the Vite dev proxy (recommended for local dev)
#   - or set the full URL of the Django API in production
VITE_API_BASE_URL=/api

# Where the Vite dev-server proxy forwards /api, /media and /static.
# Only used by vite.config.js during `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8000
